{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teapot-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "version_metadata": { "binding": "WORKER_VERSION" },
  "vars": {
    "PRESENCE_GENERATION": "global",
    "PREVIOUS_PRESENCE_GENERATION": ""
  },
  // Only the custom domain; the workers.dev URL is off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "teapot.example.com", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teapot-control",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENCE",
        "class_name": "Presence"
      },
      {
        "name": "LOGS",
        "class_name": "Logs"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "2002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Presence"]
    },
    {
      "tag": "v2-logs",
      "new_sqlite_classes": ["Logs"]
    }
  ]
}
